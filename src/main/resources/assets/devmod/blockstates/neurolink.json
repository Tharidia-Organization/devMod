{
  "multipart": [
    {
      "apply": {
        "model": "devmod:block/neurolink-center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-side"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-side",
        "y": 180
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-side",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "devmod:block/neurolink-down"
      }
    }
  ]
}
