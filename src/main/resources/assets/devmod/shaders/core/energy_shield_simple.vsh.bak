#version 150

// === Vertex Attributes (POSITION_COLOR_NORMAL format) ===
in vec3 Position;
in vec4 Color;
in vec3 Normal;

// === Uniforms ===
uniform mat4 ModelViewMat;
uniform mat4 ProjMat;
uniform float GameTime;

// === Outputs to Fragment Shader ===
out vec4 vertexColor;
out vec3 vertexNormal;
out vec3 localPosition;
out float fresnel;

void main() {
    // Transform position to clip space
    vec4 viewPos = ModelViewMat * vec4(Position, 1.0);
    gl_Position = ProjMat * viewPos;

    // Pass color through
    vertexColor = Color;

    // Pass local position for impact calculations
    localPosition = Position;

    // Transform normal to view space
    mat3 normalMat = mat3(ModelViewMat);
    vertexNormal = normalize(normalMat * Normal);

    // Calculate Fresnel effect (edge glow)
    vec3 viewDir = normalize(-viewPos.xyz);
    fresnel = pow(1.0 - max(dot(viewDir, vertexNormal), 0.0), 3.0);
}
