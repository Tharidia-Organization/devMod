{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devmod.io/schemas/arena_policy.schema.json",
  "title": "ArenaPolicy",
  "description": "Arena policy schema (L2) for DevMod v2.23",
  "type": "object",
  "required": ["id", "version", "templateId"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "description": "Unique policy identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Policy version"
    },
    "templateId": {
      "type": "string",
      "description": "Template ID reference"
    },
    "schemaVersion": {
      "type": ["string", "null"],
      "description": "Policy schema version (optional)"
    },
    "schemaHash": {
      "type": ["string", "null"],
      "description": "Schema hash (optional)"
    },
    "minTemplateVersion": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Minimum template version"
    },
    "maxTemplateVersion": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Maximum template version"
    },
    "minPlayers": { "type": ["integer", "null"], "minimum": 1 },
    "maxPlayers": { "type": ["integer", "null"], "minimum": 1 },
    "priority": { "type": "integer", "default": 0 },
    "weight": { "type": "number", "minimum": 0.1, "maximum": 10.0, "default": 1.0 },
    "enabled": { "type": "boolean", "default": true },
    "description": { "type": ["string", "null"] },

    "mobTypes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mob types for routing"
    },
    "mobIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alias of mobTypes (legacy)"
    },
    "questTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "difficultyTags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "questType": {
      "type": ["string", "null"],
      "description": "Legacy single quest type"
    },
    "difficulty": {
      "type": ["string", "null"],
      "description": "Legacy single difficulty"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },

    "routing": { "$ref": "#/$defs/Routing" },
    "perkBindings": { "$ref": "#/$defs/PerkBindings" },
    "mutatorBindings": { "$ref": "#/$defs/MutatorBindings" },
    "rewardModifiers": { "$ref": "#/$defs/RewardModifiers" },
    "balanceOverrides": { "$ref": "#/$defs/BalanceOverrides" }
  },
  "$defs": {
    "Routing": {
      "type": "object",
      "properties": {
        "mobIds": { "type": "array", "items": { "type": "string" } },
        "questTypes": { "type": "array", "items": { "type": "string" } },
        "difficultyTags": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number", "minimum": 0.1, "maximum": 10.0 }
      }
    },
    "PerkBindings": {
      "type": "object",
      "properties": {
        "suggested": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MutatorBindings": {
      "type": "object",
      "properties": {
        "suggested": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RewardModifiers": {
      "type": "object",
      "properties": {
        "baseMultiplier": { "type": "number", "minimum": 0 },
        "firstCompletionBonus": { "type": "number", "minimum": 0 },
        "hazardBonus": { "type": "number", "minimum": 0 },
        "streakMultiplier": { "type": "number", "minimum": 0 }
      }
    },
    "BalanceOverrides": {
      "type": "object",
      "properties": {
        "spawnRateMultiplier": { "type": ["number", "null"] },
        "damageMultiplier": { "type": ["number", "null"] },
        "waveScaling": { "type": ["number", "null"] }
      }
    }
  }
}
